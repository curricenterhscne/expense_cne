// 시트명·열 인덱스 등 전역 상수 — 다른 파일에서 시트명 문자열을 직접 쓰지 않도록 합니다

/**
 * 시트명 상수
 * 스프레드시트의 시트 탭 이름과 정확히 일치해야 합니다.
 */
var SHEET = {
  설정:     '설정',
  강좌목록: '강좌목록',
  신청내역: '신청내역',
  집계표:   '집계표',
  미제출:   '미제출'
};

/**
 * 신청내역 시트의 열 인덱스 (1-based, GAS 시트 API 기준)
 *
 * 접수상태 | 접수번호 | 최초제출일시 | 최종수정일시 | 수정횟수 |
 * 강좌코드 | 과목코드 | 과목명 | 전공 | 담당교사 | 소속교(예산신청교) | 연락처 |
 * 수업요일 | 수강인원 | 운영비희망여부 |
 * 항목1_구분 | 항목1_산출식 | 항목1_금액 | ... | 항목10_금액 |
 * 총소요예산 | 비고
 */
var COL = {
  접수상태:       1,
  접수번호:       2,
  최초제출일시:   3,
  최종수정일시:   4,
  수정횟수:       5,
  강좌코드:       6,
  과목코드:       7,
  과목명:         8,
  전공:           9,
  담당교사:      10,
  소속교:        11,
  연락처:        12,
  수업요일:      13,
  수강인원:      14,
  운영비희망여부: 15,
  항목시작:      16,   // 항목1_구분 (이후 3칸씩 × 10개 = 30칸)
  총소요예산:    46,   // 16 + 30
  비고:          47,
  마지막:        47    // 전체 열 수
};

/**
 * 세부 항목 최대 개수
 */
var MAX_ITEMS = 10;

/**
 * 신청내역 헤더 배열 (시트 자동 생성 시 사용)
 */
var SUBMIT_HEADERS = (function() {
  var h = [
    '접수상태', '접수번호', '최초제출일시', '최종수정일시', '수정횟수',
    '강좌코드', '과목코드', '과목명', '전공', '담당교사', '소속교(예산신청교)', '연락처',
    '수업요일', '수강인원', '운영비희망여부'
  ];
  for (var i = 1; i <= MAX_ITEMS; i++) {
    h.push('항목' + i + '_구분', '항목' + i + '_산출식', '항목' + i + '_금액');
  }
  h.push('총소요예산', '비고');
  return h;
})();
